{{ 'wearth-first-set-block.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign product = section.settings.product_handle
  if product == blank
    assign product = all_products['the-first-set']
  endif
  assign block_image = section.settings.image
  if block_image == blank and product != blank
    assign block_image = product.featured_media.preview_image | default: product.featured_image
  endif
  assign img_alt = block_image.alt | default: product.title | default: 'WEARTH First Set plant-based activewear'
-%}

<section class="wearth-first-set-block" data-wearth-first-set-block>
  <div class="wearth-first-set-block__inner">
    <a class="wearth-first-set-block__media" href="{{ section.settings.link | default: product.url }}" aria-label="{{ product.title | escape }}">
      {%- if block_image != blank -%}
        {{ block_image | image_url: width: 1200 | image_tag:
          widths: '400, 600, 800, 1000, 1200',
          sizes: '(min-width: 990px) 420px, 88vw',
          loading: 'lazy',
          decoding: 'async',
          class: 'wearth-first-set-block__image',
          alt: img_alt
        }}
      {%- endif -%}
    </a>
    <div class="wearth-first-set-block__copy">
      <p class="wearth-first-set-block__kicker">{{ section.settings.kicker }}</p>
      <h2 class="wearth-first-set-block__heading">{{ section.settings.heading }}</h2>
      <p class="wearth-first-set-block__text">{{ section.settings.text }}</p>
      <div class="wearth-first-set-block__offer">
        <strong>{{ section.settings.price_line }}</strong>
        <span>{{ section.settings.guarantee }}</span>
      </div>
      <a class="wearth-first-set-block__btn" href="{{ section.settings.link | default: product.url }}">{{ section.settings.button_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "WEARTH First Set block",
  "tag": "section",
  "class": "wearth-first-set-block-section",
  "settings": [
    {
      "type": "product",
      "id": "product_handle",
      "label": "Product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Square image (optional — defaults to product image)"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The entry point"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start with the set."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body",
      "default": "Terra Bra and Biker Shorts. The two pieces that make the fabric obvious before the story has to explain it."
    },
    {
      "type": "text",
      "id": "price_line",
      "label": "Price line",
      "default": "First Set ₹4,999. Separately ₹5,698."
    },
    {
      "type": "text",
      "id": "guarantee",
      "label": "Guarantee line",
      "default": "30 days to decide at home. Tags on. Pickup support included."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the First Set"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    }
  ],
  "presets": [
    {
      "name": "WEARTH First Set block"
    }
  ]
}
{% endschema %}
