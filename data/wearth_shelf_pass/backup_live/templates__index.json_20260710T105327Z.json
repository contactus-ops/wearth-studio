      "type": "wearth-customer-quote",
      "settings": {
        "customer_image": "",
        "image_filename": "wearth-customer-intro-alisha.jpg",
        "image_alt": "Wearth customer Alisha wearing plant-based activewear in Mumbai",
        "heading": "She tried it once.",
        "quote": "Once I tried Wearth's fabric, I couldn't explain it to anyone who hadn't. Your skin just knows. I haven't worn synthetic since.",
        "attribution": "— ALISHA, MUMBAI",
