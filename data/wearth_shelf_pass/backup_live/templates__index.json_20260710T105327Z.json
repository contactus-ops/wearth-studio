    "wearth_founder_quote_v1": {
      "type": "wearth-customer-quote",
      "settings": {
        "customer_image": "",
        "image_filename": "wearth-founder-quote-nice.jpg",
        "image_alt": "Shai, founder of Wearth, in plant-based activewear",
        "heading": "why i made this.",
        "quote": "In the rush of everyday life, movement became my one quiet hour. Then what I wore began to distract me. So I made fabric grown from trees, soft enough to forget.",
        "attribution": "— Shai",
