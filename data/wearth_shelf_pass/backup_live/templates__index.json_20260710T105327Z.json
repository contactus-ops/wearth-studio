    "wearth_mega_truth": {
      "type": "rich-text",
      "blocks": {
        "truth_heading": {
          "type": "heading",
          "settings": {
            "heading": "Here is the maths this industry hopes you never do.",
            "heading_color": "#2a241d"
          }
        },
        "truth_text": {
          "type": "text",
          "settings": {
            "text": "<p>Polyester costs a brand almost nothing. It is the cheapest fibre ever invented. Cut it, price it like a premium product, and spend the gap on the advertising that found you.<\/p><p>Our eucalyptus fibre costs around five times more to make. The number on our tag stays the same. The difference is where your money went. Theirs into ads. Ours sitting against your skin.<\/p>",
            "rte_color": "#4a4138"
          }
        },
        "truth_button": {
          "type": "button",
          "settings": {
            "button_label": "Feel the difference. 30 days, risk-free",
            "button_link": "shopify:\/\/collections\/bestsellers",
            "button_link_new": false
          }
        }
      },
      "block_order": [
