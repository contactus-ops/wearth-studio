{%- comment -%}
  Per-product size charts — Liquid only, no JavaScript.
  Mapping rules:
  - men tee/tank handles → men_tops
  - men joggers/shorts → men_bottoms
  - women tank/crop tops → women_tops
  - women sports bra → women_bra
  - women joggers/shorts/pants → women_bottoms
  - the-first-set (Terra Bra + Biker Shorts bundle) → women_first_set (bra + bottoms)
  - the-off-hours-set (Longline Tank + Women's Joggers) → women_off_hours_set
  - the-everyday-set (Motion Tee + Men's Joggers) → men_everyday_set
  - the-studio-crop → women_bottoms (same as women joggers — founder override)
{%- endcomment -%}

{%- assign wearth_sc = '' -%}
{%- case product.handle -%}
  {%- when 'sleeveless-regular-fit-tshirt-men', 'men-raglan-tshirt' -%}
    {%- assign wearth_sc = 'men_tops' -%}
  {%- when 'mens-everyday-joggers', 'mens-essential-shorts' -%}
    {%- assign wearth_sc = 'men_bottoms' -%}
  {%- when 'womens-tank-top', 'flow-tank', 'womens-power-crop', 'power-crop' -%}
    {%- assign wearth_sc = 'women_tops' -%}
  {%- when 'align-sports-bra', 'terra-sports-bra' -%}
    {%- assign wearth_sc = 'women_bra' -%}
  {%- when 'womens-biker-shorts', 'womens-everyday-joggers', 'the-off-hours-wide-leg', 'the-off-duty-short', 'the-studio-crop' -%}
    {%- assign wearth_sc = 'women_bottoms' -%}
  {%- when 'the-first-set' -%}
    {%- assign wearth_sc = 'women_first_set' -%}
  {%- when 'the-off-hours-set' -%}
    {%- assign wearth_sc = 'women_off_hours_set' -%}
  {%- when 'the-everyday-set' -%}
    {%- assign wearth_sc = 'men_everyday_set' -%}
{%- endcase -%}

{%- case wearth_sc -%}

