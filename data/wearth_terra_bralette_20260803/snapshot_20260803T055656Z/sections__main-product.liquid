{%- comment -%} WEARTH_STICKY_BAG_NUCLEAR_WEBVIEW {%- endcomment -%}
<script>
(function () {
  var bar = document.querySelector('[data-wearth-sticky-bag]');
  if (!bar) return;
  var priceEl = bar.querySelector('[data-wearth-sticky-price]');
  var submitBtn = bar.querySelector('[data-wearth-sticky-submit]');
  var formId = {{ product_form_id | json }};
  var sectionKey = {{ section.id | json }};
  var productKey = {{ product.id | json }};
  var variants = [];
  var busy = false;
  try {
    var raw = document.querySelector('[data-wearth-sticky-variants]');
    variants = raw ? JSON.parse(raw.textContent || '[]') : [];
  } catch (e) { variants = []; }

  function money(cents) {
    try {
      if (window.Shopify && Shopify.formatMoney) {
        return Shopify.formatMoney(cents, {{ shop.money_format | json }});
      }
    } catch (e2) {}
    return '₹' + (Number(cents) / 100).toFixed(0);
  }

  function root() {
    return document.querySelector(
      'variant-radios[data-section="' + sectionKey + '"][data-product="' + productKey + '"],' +
      'variant-selects[data-section="' + sectionKey + '"][data-product="' + productKey + '"]'
    );
  }

  function selectedOptions() {
    var r = root();
    if (!r) return [];
    if (r.tagName.toLowerCase() === 'variant-selects') {
      return Array.from(r.querySelectorAll('select')).map(function (sel) { return sel.value; });
    }
    return Array.from(r.querySelectorAll('fieldset')).map(function (fieldset) {
      var checked = fieldset.querySelector('input:checked');
      return checked ? checked.value : '';
    });
  }

  function syncFromSelection() {
    var options = selectedOptions();
    var match = variants.find(function (variant) {
      return variant.options && variant.options.every(function (opt, idx) {
        return String(opt) === String(options[idx]);
      });
    });
    if (!match) return null;
    var form = document.getElementById(formId);
    if (form) {
      var input = form.querySelector('input[name="id"]');
      if (input) {
        input.disabled = false;
        input.value = String(match.id);
      }
    }
    if (priceEl) priceEl.textContent = money(match.price);
    if (submitBtn) submitBtn.disabled = !match.available;
    return match;
  }

  function setVisible(on) {
    /* Mobile only — never show sticky chrome on tablet/desktop */
    if (window.matchMedia && window.matchMedia('(min-width: 750px)').matches) on = false;
    bar.classList.toggle('is-visible', !!on);
    bar.setAttribute('aria-hidden', on ? 'false' : 'true');
  }

  function atcTarget() {
    return (
      document.querySelector('[data-wearth-pdp-mobile-atc]') ||
      document.querySelector('.wearth-pdp-desktop-atc-slot') ||
      document.querySelector('#' + formId + ' [data-add-to-cart], #' + formId + ' button[name="add"], button.AddToCart')
    );
  }

  function updateVisibility() {
    var atc = atcTarget();
    if (!atc) {
      /* WebView failsafe: show after modest scroll if ATC node missing/hidden */
      setVisible(window.scrollY > 220);
      return;
    }
    var rect = atc.getBoundingClientRect();
    var vh = window.innerHeight || document.documentElement.clientHeight || 0;
    var inView = rect.bottom > 0 && rect.top < vh;
    /* Show sticky when primary ATC scrolled off OR user has scrolled meaningfully (IG WebView IO bugs) */
    setVisible(!inView || window.scrollY > Math.max(280, vh * 0.45));
  }

  function watchAtc() {
    updateVisibility();
    var atc = atcTarget();
    if (atc && 'IntersectionObserver' in window) {
      try {
        var io = new IntersectionObserver(function () { updateVisibility(); }, { threshold: [0, 0.01, 1], rootMargin: '0px' });
        io.observe(atc);
      } catch (e3) {}
    }
    window.addEventListener('scroll', updateVisibility, { passive: true });
    window.addEventListener('resize', updateVisibility);
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', updateVisibility);
      window.visualViewport.addEventListener('scroll', updateVisibility);
    }
    /* Second pass after IG delayed layout */
    window.setTimeout(updateVisibility, 600);
    window.setTimeout(updateVisibility, 1600);
  }

  function openCartDrawer() {
    try {
      if (window.ajaxCart && typeof window.ajaxCart.load === 'function') window.ajaxCart.load();
    } catch (e4) {}
    try {
      if (window.mono && window.mono.RightDrawer && typeof window.mono.RightDrawer.open === 'function') {
        window.mono.RightDrawer.open();
        return;
      }
    } catch (e5) {}
    var triggers = [
      '.js-drawer-open-right',
      '[data-drawer-open]',
      'a[href="#CartDrawer"]',
      'button[aria-controls="CartDrawer"]',
      '#cart-icon-bubble',
      '.header__icon--cart'
    ];
    for (var i = 0; i < triggers.length; i++) {
      var el = document.querySelector(triggers[i]);
      if (el) {
        try { el.click(); return; } catch (e6) {}
      }
    }
  }

  function addViaFetch(variantId) {
    return fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] })
    }).then(function (response) {
      return response.json().then(function (data) {
        if (!response.ok) throw data;
        return data;
      });
    });
  }

  function onStickyClick(event) {
    event.preventDefault();
    event.stopPropagation();
    if (typeof event.stopImmediatePropagation === 'function') event.stopImmediatePropagation();
    if (busy || !submitBtn || submitBtn.disabled) return;
    var match = syncFromSelection();
    var form = document.getElementById(formId);
    var idInput = form && form.querySelector('input[name="id"]');
    var variantId = (match && match.id) || (idInput && idInput.value);
    if (!variantId) return;

    busy = true;
    submitBtn.setAttribute('aria-busy', 'true');

    /* Prefer native form submit path first (bundles / ajaxCart hooks), then fetch fallback */
    var usedNative = false;
    try {
      if (form) {
        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
          usedNative = true;
        } else {
          var nativeBtn = document.querySelector('[data-wearth-pdp-mobile-atc] button, .wearth-pdp-desktop-atc-slot button[name="add"], button.AddToCart');
          if (nativeBtn) {
            nativeBtn.click();
            usedNative = true;
          }
        }
      }
    } catch (e7) { usedNative = false; }

    if (usedNative) {
      window.setTimeout(function () {
        busy = false;
        submitBtn.removeAttribute('aria-busy');
        openCartDrawer();
      }, 900);
      return;
    }

    addViaFetch(variantId)
      .then(function () {
        openCartDrawer();
        try {
          document.documentElement.dispatchEvent(new CustomEvent('cart:updated'));
          if (window.jQuery) window.jQuery(document.body).trigger('cart:added');
        } catch (e8) {}
      })
      .catch(function () {
        /* last resort: navigate add */
        window.location.href = '/cart/add?id=' + encodeURIComponent(String(variantId)) + '&quantity=1';
      })
      .finally(function () {
        busy = false;
        submitBtn.removeAttribute('aria-busy');
      });
  }

  if (submitBtn) {
    submitBtn.addEventListener('click', onStickyClick, true);
  }

  var r = root();
  if (r) r.addEventListener('change', syncFromSelection);
  document.addEventListener('change', function (evt) {
    if (!evt.target) return;
    if (evt.target.closest('variant-radios, variant-selects')) syncFromSelection();
  });
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      syncFromSelection();
      watchAtc();
    });
  } else {
    syncFromSelection();
    watchAtc();
  }
})();
</script>



{%- comment -%} WEARTH_PDP_VARIANT_ID_SYNC {%- endcomment -%}
<script>
(function () {
  var formId = {{ product_form_id | json }};
  var sectionKey = {{ section.id | json }};
  var productKey = {{ product.id | json }};
  var root = document.querySelector(
    'variant-radios[data-section="' + sectionKey + '"][data-product="' + productKey + '"],' +
    'variant-selects[data-section="' + sectionKey + '"][data-product="' + productKey + '"]'
  );
  if (!root) return;

  function parseVariants() {
    try {
      return JSON.parse(root.querySelector('[type="application/json"]').textContent || '[]');
    } catch (e) {
      return [];
    }
  }

  function selectedOptions() {
    if (root.tagName.toLowerCase() === 'variant-selects') {
      return Array.from(root.querySelectorAll('select')).map(function (sel) {
        return sel.value;
      });
    }
    return Array.from(root.querySelectorAll('fieldset')).map(function (fieldset) {
      var checked = fieldset.querySelector('input:checked');
      return checked ? checked.value : '';
    });
  }

  function resolveVariantId() {
    var options = selectedOptions();
    if (!options.length || options.some(function (opt) { return !opt; })) return '';
    var variants = parseVariants();
    var match = variants.find(function (variant) {
      return (
        variant.options &&
        variant.options.every(function (opt, idx) {
          return String(opt) === String(options[idx]);
        })
      );
    });
    return match ? String(match.id) : '';
  }

  function syncVariantInput() {
    var variantId = resolveVariantId();
    if (!variantId) return;
    var form = document.getElementById(formId);
    if (!form) return;
    var input = form.querySelector('input[name="id"]');
    if (!input) return;
    input.disabled = false;
    input.value = variantId;
    var sticky = document.querySelector('.wearth-sticky-checkout__form[data-wearth-sticky-sync] input[name="id"]');
    if (sticky) sticky.value = variantId;
    document.querySelectorAll('#var_id, .sticky-id').forEach(function (node) {
      node.value = variantId;
    });
  }

  root.addEventListener('change', syncVariantInput);
  document.addEventListener('submit', function (evt) {
    if (!evt.target || evt.target.id !== formId) return;
    syncVariantInput();
  }, true);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncVariantInput);
  } else {
    syncVariantInput();
  }
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var stickyForm = document.querySelector('.wearth-sticky-checkout__form[data-wearth-sticky-sync]');
  if (!stickyForm) return;
  stickyForm.addEventListener('submit', function () {
    try {
      var srcForm = document.getElementById({{ product_form_id | json }});
      var src = srcForm ? srcForm.querySelector('input[name="id"]') : null;
      if (src && src.value) {
        var dst = stickyForm.querySelector('input[name="id"]');
        if (dst) dst.value = src.value;
      }
    } catch (e) {}
  });
});
</script>

<script>
document.addEventListener('click', function(e){
  var t = e.target.closest('.wearth-reviews-toggle');
  if(!t) return;
  var panel = t.parentElement.querySelector('.wearth-reviews-panel');
  var chev = t.querySelector('.wearth-reviews-toggle-chev');
  if(!panel) return;
  var open = panel.hasAttribute('hidden');
  if(open){ panel.removeAttribute('hidden'); t.setAttribute('aria-expanded','true'); if(chev) chev.textContent='\u2013'; }
  else { panel.setAttribute('hidden',''); t.setAttribute('aria-expanded','false'); if(chev) chev.textContent='+'; }
});
document.addEventListener('click', function(e){
  var a = e.target.closest('.wearth-rating-summary');
  if(!a) return;
  e.preventDefault();
  var tgt = document.querySelector('#wearth-reviews');
  if(tgt){ tgt.scrollIntoView({behavior:'smooth', block:'center'});
    var toggle = tgt.querySelector('.wearth-reviews-toggle');
    var panel = tgt.querySelector('.wearth-reviews-panel');
    if(panel && panel.hasAttribute('hidden') && toggle) toggle.click();
  }
});
</script>

