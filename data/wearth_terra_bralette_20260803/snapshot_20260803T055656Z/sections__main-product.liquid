                        var mobile = document.querySelector("[data-wearth-pdp-mobile-atc]");
                        var desktop = document.querySelector("[data-wearth-pdp-desktop-atc]");
                        if (mobile) mobile.style.display = isMobile ? "" : "none";
                        if (desktop) desktop.style.display = isDesktop ? "" : "none";
                      }
                      if (document.readyState === "loading") {
                        document.addEventListener("DOMContentLoaded", hideStaleBuyAtc);
                      } else {
                        hideStaleBuyAtc();
                      }
